; SCRAP-A-BOT — configuracao de projeto
; Valores derivados do GDD secao 7.1

config_version=5

[application]

config/name="SCRAP-A-BOT"
config/description="Roguelite de arena com ricochete. Marco: Prototipo."
run/main_scene="res://scenes/prototype.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

CombatFeel="*res://autoload/combat_feel.gd"
GameRng="*res://autoload/game_rng.gd"
GameInput="*res://autoload/game_input.gd"
Sfx="*res://autoload/sfx.gd"
Vfx="*res://autoload/vfx.gd"
Telemetry="*res://autoload/telemetry.gd"
MetaManager="*res://autoload/meta_manager.gd"
Settings="*res://autoload/settings.gd"

[debug]

settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[layer_names]

2d_physics/layer_1="walls"
2d_physics/layer_2="enemies"
2d_physics/layer_3="player"
2d_physics/layer_4="pickups"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=false
2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=0
